AUTH_SECRET=            # openssl rand -base64 32
AUTH_GOOGLE_ID=         # 구글 OAuth 클라이언트 ID
AUTH_GOOGLE_SECRET=     # 구글 OAuth 클라이언트 시크릿
# 로컬에서 백엔드를 띄운 주소. 포트를 옮겼으면 여기도 같이 바꾼다.
BACKEND_URL=http://localhost:8080
# **비워 둔다.** 예시 값을 적어 두면 그대로 복사돼 배포로 나간다 —
# 이전에 여기 있던 `local-dev-secret` 은 저장소 히스토리에 남아 있어
# 누구나 읽을 수 있다. 반드시 새로 만든다:
#   openssl rand -base64 32 | tr -d '/+='
BACKEND_SHARED_SECRET=
# 질의 무제한 알리스트(쉼표 구분). 보통 본인 이메일.
ASK_ALLOWLIST=
# 알리스트 밖 사용자의 하루 질의 상한.
ASK_DAILY_LIMIT=10
