AUTH_SECRET=            # openssl rand -base64 32
AUTH_GOOGLE_ID=         # 구글 OAuth 클라이언트 ID
AUTH_GOOGLE_SECRET=     # 구글 OAuth 클라이언트 시크릿
BACKEND_URL=http://localhost:8080
BACKEND_SHARED_SECRET=local-dev-secret
ADMIN_EMAILS=            # 콤마로 구분된 관리자 이메일 목록. 비어 있으면 아무도 관리자가 아니다.
# 질의 무제한 알리스트(쉼표 구분). 보통 본인 이메일.
ASK_ALLOWLIST=
# 알리스트 밖 사용자의 하루 질의 상한.
ASK_DAILY_LIMIT=10
