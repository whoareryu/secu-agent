# 로컬 개발 환경 변수 견본.
#
#   cp .env.example .env
#
# .env 는 .gitignore 에 있어 커밋되지 않는다. 이 파일(.env.example)은 커밋된다 —
# 값이 아니라 "무엇이 필요한지"를 남기는 것이 목적이다.

# ─── 생성 모델 (Gemini · Vertex/Agent Platform 경로) ───────────────────
# AI Studio 의 API 키 경로가 아니다. 이유는 요금 — Google Cloud 무료 체험판
# 크레딧이 AI Studio Gemini API 는 커버하지 않고 Agent Platform 은 커버한다.
#
# 자격증명은 서비스 계정 JSON 이다. Console 의 IAM → 서비스 계정에서 키를
# 만들어 저장소 루트에 gcp-sa.json 으로 둔다(.gitignore 에 이미 있다).
GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa.json
GOOGLE_CLOUD_PROJECT=
# 실측으로 확인한 리전. 바꾸려면 실제로 호출해보고 바꾼다.
GOOGLE_CLOUD_LOCATION=global

# ─── 백엔드 공유 시크릿 ────────────────────────────────────────────────
# 프론트(Next.js Route Handler)가 백엔드를 부를 때 다는 값. 브라우저에는
# 내려가지 않는다. 백엔드에 주입하는 값과 반드시 같아야 한다.
#
# **반드시 ASCII 여야 한다.** HTTP 헤더 값은 ASCII 만 허용되고,
# hmac.compare_digest 는 양쪽이 같은 비ASCII 문자열이어도 TypeError 로 죽는다.
# 백엔드가 비ASCII 시크릿을 500 으로 거부한다.
#
# 배포용은 재사용하지 말고 새로 만든다:  openssl rand -base64 32 | tr -d '/+='
# **비워 둔다.** 예시 값을 적어 두면 그대로 복사돼 배포로 나간다 —
# 이전에 여기 있던 `local-dev-secret` 은 저장소 히스토리에 남아 있어
# 누구나 읽을 수 있다. 반드시 새로 만든다:
#   openssl rand -base64 32 | tr -d '/+='
BACKEND_SHARED_SECRET=

# ─── 데이터베이스 ──────────────────────────────────────────────────────
# 비워두면 호스트에서 도는 파이썬은 localhost:5433 (docker-compose 매핑)을,
# 클러스터의 백엔드는 secu-db:5432 (deploy/k8s/db-endpoint.yaml)를 쓴다.
#
# 슈파베이스로 옮길 때 고치는 곳이 여기다. 값을 적고 secret.sh 를 다시
# 돌린 뒤 db-endpoint.yaml 을 지우면 끝난다 — 매니페스트도 코드도 그대로다.
SECUAGENT_DSN=

# ─── Cloudflare 터널 ───────────────────────────────────────────────────
# 클러스터의 cloudflared 가 쓰는 토큰. Zero Trust → Networks → Tunnels 에서
# secu-agent 전용 터널을 만들고 그 토큰을 여기 붙인다. 라우트는 대시보드에
# 두고, 목적지를 `http://secu-backend:8080` 으로 준다 — 클러스터 안 이름이다.
#
# 새싹 스택의 터널과 **다른 터널이어야 한다.** 같은 터널을 두 곳에서 돌리면
# 라우트 설정이 서로를 덮어쓴다.
TUNNEL_TOKEN=
